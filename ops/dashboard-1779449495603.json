                      "spec": {
                        "editorMode": "code",
                        "expr": "histogram_quantile(0.95, sum by (le, node_name) (rate(agent_graph_node_latency_seconds_bucket[5m])))",
                        "legendFormat": "{{node_name}}",
                        "range": true
